# ============================================================
# inAct Journal Platform — Environment Variables
# Copy this file to .env and fill in your values.
# ============================================================

# Django core
SECRET_KEY=change-me-generate-with-python-secrets-token-hex-50
DEBUG=True
DJANGO_SETTINGS_MODULE=config.settings.development
ALLOWED_HOSTS=localhost,127.0.0.1

# Database (PostgreSQL) — deploy.sh creates this role + database automatically
DB_NAME=inact_journal
DB_USER=inact
DB_PASSWORD=devpassword
DB_HOST=localhost
DB_PORT=5432

# Superuser (created automatically by deploy.sh / setup script)
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_PASSWORD=change-me-strong-password
DJANGO_SUPERUSER_EMAIL=admin@inact.lmta.lt

# Redis / Celery
# Dev: not required — all tasks run synchronously (no Redis or worker needed)
# Production: set CELERY_BROKER_URL and run a worker for async PDF generation
# CELERY_BROKER_URL=redis://localhost:6379/0

# ─── WeasyPrint (PDF generation) ─────────────────────────────
# macOS + Homebrew: WeasyPrint needs GLib/Pango shared libraries.
# Run: brew install pango && add the line below to your .env
# DYLD_LIBRARY_PATH=/opt/homebrew/lib

# ─── Email ───────────────────────────────────────────────────
# Backend: 'mailersend' | 'sendgrid' | 'mailgun' | 'console' (dev default)
ANYMAIL_BACKEND=mailersend
MAILERSEND_API_TOKEN=
DEFAULT_FROM_EMAIL=noreply@inact.lmta.lt
DEFAULT_FROM_NAME=inAct Journal
SERVER_EMAIL=admin@inact.lmta.lt

# ─── ORCID OAuth ─────────────────────────────────────────────
# Register at https://orcid.org/developer-tools
ORCID_OAUTH_ENABLED=False
ORCID_CLIENT_ID=
ORCID_CLIENT_SECRET=

# ─── DOI / Crossref ──────────────────────────────────────────
# Requires Crossref membership — https://www.crossref.org
DOI_ENABLED=False
CROSSREF_LOGIN=
CROSSREF_PASSWORD=
CROSSREF_DEPOSITOR_NAME=inAct Journal
CROSSREF_DEPOSITOR_EMAIL=

# ─── Turnitin ────────────────────────────────────────────────
# Requires institutional TCA API access
TURNITIN_ENABLED=False
TURNITIN_API_KEY=
TURNITIN_BASE_URL=https://api.turnitin.com

# ─── AI Features (reviewer semantic matching) ────────────────
# Scaffolded. Enable only when API key is available.
AI_FEATURES_ENABLED=False
OPENAI_API_KEY=

# ─── Media streaming (video/audio → protected HLS) ───────────
# Video & audio are transcoded to HLS with ffmpeg and served only through
# signed, short-lived URLs — never as a directly downloadable file. Requires the
# `ffmpeg` system package (installed by scripts/deploy.sh) and the inact-transcode
# worker. Defaults work out of the box; override only if needed.
# MEDIA_STREAMING_ENABLED=True
# MEDIA_SIGNED_URL_TTL=10800     # seconds a playback URL stays valid (default 3h)
# USE_X_ACCEL=True               # prod: Nginx serves bytes via X-Accel-Redirect
#                                #   (auto-on when DEBUG=False; set False if no Nginx)
# FFMPEG_BIN=ffmpeg              # override if ffmpeg/ffprobe are not on PATH

# ─── Storage ─────────────────────────────────────────────────
# Local filesystem (default for dev and initial production)
MEDIA_ROOT=./media
USE_S3=False
# S3-compatible storage (Phase 2 upgrade — see README)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=
AWS_S3_ENDPOINT_URL=

# ─── Production / Staging ────────────────────────────────────
# Both environments use config.settings.production (staging.py is identical).
# SITE_URL is the single source of truth: STATIC_URL, MEDIA_URL, LOGIN_URL,
# CSRF_TRUSTED_ORIGINS, and SCRIPT_NAME are all derived from it automatically.
#
# Root-path domain (production):
#   SITE_URL=https://inact.lmta.lt
#
# Subpath on a shared server (staging):
#   SITE_URL=https://misc.lmta.lt/ARJournal
#
# Other required values for production/staging:
# DJANGO_SETTINGS_MODULE=config.settings.production
# DEBUG=False
# SECRET_KEY=<strong-random-key>
# ALLOWED_HOSTS=inact.lmta.lt,www.inact.lmta.lt
# CORS_ALLOWED_ORIGINS=https://inact.lmta.lt
# SENTRY_DSN=
